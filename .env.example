# Choose: demo, auto, groq, or openai
AI_PROVIDER=auto

# Groq configuration (recommended if you want to use Groq)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional OpenAI configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Backward compatibility with the earlier OpenAI setup
USE_OPENAI=false
